{
  "name": "vite-plugin-image-sizes",
  "version": "1.3.0",
  "description": "A Vite plugin to automatically add width and height attributes to img and source tags.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "test:build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:images": "node e2e-smoke/scripts/generate-images.mjs",
    "e2e:build": "node e2e-smoke/scripts/run-build.mjs",
    "e2e:check": "node e2e-smoke/scripts/check-e2e.mjs",
    "e2e:vite6": "cross-env VITE_MAJOR_VERSION=6 npm run e2e:build && npm run e2e:check",
    "e2e:vite7": "cross-env VITE_MAJOR_VERSION=7 npm run e2e:build && npm run e2e:check",
    "e2e:vite8": "cross-env VITE_MAJOR_VERSION=8 npm run e2e:build && npm run e2e:check",
    "e2e": "npm run e2e:images && npm run e2e:vite6 && npm run e2e:vite7 && npm run e2e:vite8",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozekimasaki/vite-plugin-image-sizes.git"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "image",
    "size",
    "cls"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ozekimasaki/vite-plugin-image-sizes/issues"
  },
  "homepage": "https://github.com/ozekimasaki/vite-plugin-image-sizes#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite6": "npm:vite@^6.4.3",
    "vite7": "npm:vite@^7.3.6",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  }
}
